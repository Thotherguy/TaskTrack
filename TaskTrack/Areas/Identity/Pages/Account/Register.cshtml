@page
@model TaskTrack.Areas.Identity.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Register"; }
<h1>Create an account</h1>
<div class="row"><div class="col-md-5">
<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control" autocomplete="username" /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.Password"></label><input asp-for="Input.Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Input.Password" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>
    <p>Use at least 12 characters, including uppercase and lowercase letters, a number, and a symbol.</p>
    <button type="submit" class="btn btn-primary">Register</button>
</form>
</div><div class="col-md-6 offset-md-1">
@if (Model.ExternalLogins.Count > 0)
{
    <h2>Use another service</h2>
    <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    @foreach (var provider in Model.ExternalLogins)
    { <button type="submit" class="btn btn-outline-primary" name="provider" value="@provider.Name">@provider.DisplayName</button> }
    </form>
}
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
