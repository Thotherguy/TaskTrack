@{ ViewData["Title"] = "Welcome"; }
<section class="py-5"><p class="text-uppercase text-muted mb-2">TaskTrack</p><h1 class="display-4 fw-semibold">A clear view of your team’s work.</h1><p class="lead text-muted col-lg-8">Organize projects, assign tasks, and keep the conversation and progress together.</p>
@if (User.Identity?.IsAuthenticated == true) { <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg">Open dashboard</a> }
else { <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg">Create an account</a> <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary btn-lg">Sign in</a> }
</section><div class="row g-4 mb-4"><div class="col-md-4"><h2 class="h4">Plan the project</h2><p class="text-muted">Keep project details, deadlines, and your team in one place.</p></div><div class="col-md-4"><h2 class="h4">Move work forward</h2><p class="text-muted">See assigned tasks and update progress as work gets done.</p></div><div class="col-md-4"><h2 class="h4">Keep the context</h2><p class="text-muted">Discuss tasks with comments and follow the activity history.</p></div></div>
