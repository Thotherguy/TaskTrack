@model TaskTrack.Models.ProjectActivityViewModel
@{ ViewData["Title"] = "Project Activity"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><p class="text-muted mb-1">@Model.Project.Name</p><h1>Project activity</h1></div><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project.Id" class="btn btn-outline-secondary">Back to project</a></div>
@if (!Model.Events.Any()) { <p class="text-muted">No activity is available on this page. New changes will be recorded here.</p> }
<ul class="list-group mb-3">@foreach (var item in Model.Events) { <li class="list-group-item"><div>@item.Summary</div><small class="text-muted">@(item.ActorId == null ? "System" : Model.UserNames.GetValueOrDefault(item.ActorId, "Deleted user")) · @item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</small></li> }</ul>
<nav aria-label="Activity pages" class="d-flex align-items-center gap-3">
@if (Model.Page > 1) { <a asp-action="Index" asp-route-projectId="@Model.Project.Id" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">Newer activity</a> }
<span>Page @Model.Page</span>
@if (Model.HasMore) { <a asp-action="Index" asp-route-projectId="@Model.Project.Id" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">Older activity</a> }
</nav>
