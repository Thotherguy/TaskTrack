@model TaskTrack.Models.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><p class="text-uppercase text-muted mb-1">TaskTrack overview</p><h1 class="mb-1">Dashboard</h1><p class="text-muted mb-0">Your projects, work in progress, and latest updates.</p></div>
    <a asp-controller="Projects" asp-action="Index" class="btn btn-primary">View projects</a>
</div>
<div class="row g-3 mb-4">
@foreach (var item in new[] { ("Projects", Model.ProjectCount, "primary"), ("Tasks", Model.TaskCount, "secondary"), ("To Do", Model.ToDoCount, "secondary"), ("In Progress", Model.InProgressCount, "primary"), ("Completed", Model.CompletedCount, "success"), ("Overdue", Model.OverdueCount, "danger") })
{
    <div class="col-6 col-lg-2"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted small">@item.Item1</div><div class="fs-2 fw-semibold text-@item.Item3">@item.Item2</div></div></div></div>
}
</div>
<div class="row g-4">
<div class="col-lg-7"><section class="card h-100"><div class="card-body"><h2 class="h4">Next tasks</h2>
@if (!Model.UpcomingTasks.Any()) { <p class="text-muted mb-0">No open tasks are available to you.</p> }
else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Task</th><th>Project</th><th>Due</th><th>Status</th></tr></thead><tbody>
@foreach (var task in Model.UpcomingTasks) { <tr><td><a asp-controller="ProjectTasks" asp-action="Details" asp-route-id="@task.Id">@task.Title</a></td><td>@task.Project.Name</td><td class="text-nowrap">@(task.DueDate?.ToShortDateString() ?? "No date")</td><td class="text-nowrap">@task.Status</td></tr> }
</tbody></table></div> }
</div></section></div>
<div class="col-lg-5"><section class="card h-100"><div class="card-body"><h2 class="h4">Recent activity</h2>
@if (!Model.RecentActivity.Any()) { <p class="text-muted mb-0">New project and task changes will appear here.</p> }
else { <ul class="list-group list-group-flush">@foreach (var item in Model.RecentActivity) { <li class="list-group-item px-0"><div>@item.Summary</div><small class="text-muted">@item.Project.Name · @(item.ActorId == null ? "System" : Model.UserNames.GetValueOrDefault(item.ActorId, "Deleted user")) · @item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</small></li> }</ul> }
</div></section></div>
</div>
